# Development only. Đổi password trước khi chạy database.
POSTGRES_DB=stockmate
POSTGRES_USER=stockmate
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432
# Backend đọc biến môi trường của process, không tự đọc file .env.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/stockmate
SPRING_DATASOURCE_USERNAME=stockmate
SPRING_DATASOURCE_PASSWORD=replace-with-local-password
SERVER_PORT=8080
GEMINI_API_KEY=
GEMINI_MODEL=
AI_ENABLED=false
REPLENISHMENT_SCHEDULING_ENABLED=false
